# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Image search. The pipeline uses SerpApi's google_images engine.
# (The README used to name Bing; no code has called Bing for a long time.)
SERP_API_KEY=

# Role discovery, and the reference portrait used for identity verification.
# Strongly recommended: without it, identity checks fall back to unaided
# recognition, which is much weaker for less famous performers.
TMDB_API_KEY=

# Destination for the finished zip.
GOOGLE_DRIVE_FOLDER_ID=
# Service account JSON is read from ./credentials/google-drive-creds.json

# ---------------------------------------------------------------------------
# Identity verification — at least one of these is required
#
# With neither key set, no image can be confirmed as the right person and the
# run will produce nothing. That is deliberate: shipping unverified images is
# how the wrong person ends up in a print package.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Search tuning — the floor for accepting a candidate image off the web.
# NOT the print size. Raising these past roughly 1200x1200 starts rejecting
# most of the indexed web.
# ---------------------------------------------------------------------------
MIN_SEARCH_WIDTH=900
MIN_SEARCH_HEIGHT=900
MIN_FILE_SIZE_BYTES=51200
MAX_ASPECT_RATIO=2.5

# Terms excluded from every image query, comma separated. For older titles a
# large share of what exists online is retail listings, and a photograph of a
# VHS sleeve is not sellable as an autograph print. Excluding them here is much
# cheaper than paying for a vision call to reject each one.
SEARCH_EXCLUDE_TERMS=vhs,dvd,bluray,blu-ray,ebay,amazon,etsy,boxset,box set,for sale,poster for sale,laserdisc

# ---------------------------------------------------------------------------
# Print quality
# ---------------------------------------------------------------------------

# An image is offered in a print format only if it can fill that sheet at this
# DPI or better WITHOUT being enlarged.
#   150 = sharp at arm's length, accepts most usable web images (default)
#   200 = noticeably crisper, noticeably fewer images
#   300 = true photographic print quality, very few web images qualify
MIN_PRINT_DPI=150

# Enlarging makes a small image the right dimensions but not the right
# quality. Leave this off unless you specifically want padded-out files.
ALLOW_UPSCALE=false

JPEG_QUALITY=95

# ---------------------------------------------------------------------------
# Verification tuning
# ---------------------------------------------------------------------------

# "high" is required to tell similar-looking people apart. "low" downsamples
# to ~512px before the model sees the image and costs less, at the price of
# exactly the mistakes this system exists to avoid.
VISION_DETAIL=high

# Minimum model confidence (1-10) for an image to be accepted.
# Raise toward 8-9 if wrong-person images are still getting through.
MIN_VERIFY_CONFIDENCE=7

# Compare candidates against a TMDb portrait rather than relying on the model
# recognising the name. Requires TMDB_API_KEY.
USE_REFERENCE_IMAGE=true

# Override the model used for the Claude verification fallback.
# ANTHROPIC_VERIFY_MODEL=claude-opus-5

# Set to false to skip identity verification entirely. Only for debugging the
# search stage — output is not safe to print.
ENABLE_AI_VERIFICATION=true

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
MAX_IMAGES_PER_ROLE=50
DEDUP_THRESHOLD=0.85
API_PORT=4000
