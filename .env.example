# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Image search. The pipeline uses SerpApi's google_images engine.
# (The README used to name Bing; no code has called Bing for a long time.)
SERP_API_KEY=

# Role discovery, and the reference portrait used for identity verification.
# Strongly recommended: without it, identity checks fall back to unaided
# recognition, which is much weaker for less famous performers.
TMDB_API_KEY=

# Destination for the finished zip.
GOOGLE_DRIVE_FOLDER_ID=
# Service account JSON is read from ./credentials/google-drive-creds.json

# ---------------------------------------------------------------------------
# Identity verification — at least one of these is required
#
# With neither key set, no image can be confirmed as the right person and the
# run will produce nothing. That is deliberate: shipping unverified images is
# how the wrong person ends up in a print package.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Search tuning — the floor for accepting a candidate image off the web.
# NOT the print size. Raising these past roughly 1200x1200 starts rejecting
# most of the indexed web.
# ---------------------------------------------------------------------------
MIN_SEARCH_WIDTH=900
MIN_SEARCH_HEIGHT=900
MIN_FILE_SIZE_BYTES=51200
MAX_ASPECT_RATIO=2.5

# Image downloads in flight at once. These are network-bound, so running them
# one at a time (the old behaviour) left a job idle most of its runtime. Raise
# for speed; lower if the droplet struggles or the host rate-limits you.
DOWNLOAD_CONCURRENCY=6

# Terms excluded from every image query, comma separated.
#
# Keep this list NARROW. A negative term matches the whole page, not the image,
# so adding "dvd" would also drop the Wikipedia and IMDb pages that mention a
# DVD release — which for an older title is most of the pages carrying good
# stills. Broad markers (dvd, blu-ray, amazon) are filtered at download time
# against the image's own title and URL instead, where matching is precise.
# Set to empty to disable this layer entirely.
SEARCH_EXCLUDE_TERMS=ebay,etsy,for sale,boxset,box set,laserdisc

# ---------------------------------------------------------------------------
# Print quality
# ---------------------------------------------------------------------------

# An image is offered in a print format only if it can fill that sheet at this
# DPI or better WITHOUT being enlarged.
#   130 = lets full-HD (1920x1080) screenshots through as 8x10s; looks right at
#         arm's length (default)
#   150 = a little crisper up close, but most TV screenshots no longer qualify
#   200+ = noticeably crisper, far fewer images
MIN_PRINT_DPI=130

# Enlarging makes a small image the right dimensions but not the right
# quality. Leave this off unless you specifically want padded-out files.
ALLOW_UPSCALE=false

JPEG_QUALITY=95

# ---------------------------------------------------------------------------
# Verification tuning
# ---------------------------------------------------------------------------

# "high" is required to tell similar-looking people apart. "low" downsamples
# to ~512px before the model sees the image and costs less, at the price of
# exactly the mistakes this system exists to avoid.
VISION_DETAIL=high

# Minimum model confidence (1-10) for an image to be accepted.
# Raise toward 8-9 if wrong-person images are still getting through.
MIN_VERIFY_CONFIDENCE=7

# Compare candidates against a TMDb portrait rather than relying on the model
# recognising the name. Requires TMDB_API_KEY.
USE_REFERENCE_IMAGE=true

# Vision calls in flight at once. Lower than DOWNLOAD_CONCURRENCY because each
# call carries image data and provider rate limits bite sooner than bandwidth.
VERIFY_CONCURRENCY=4

# Override the model used for the Claude verification fallback.
# ANTHROPIC_VERIFY_MODEL=claude-opus-5

# Set to false to skip identity verification entirely. Only for debugging the
# search stage — output is not safe to print.
ENABLE_AI_VERIFICATION=true

# ---------------------------------------------------------------------------
# Models — change provider or model here, not in five source files
# ---------------------------------------------------------------------------

# To list the models your key can use:
#   curl -s https://api.openai.com/v1/models -H "Authorization: Bearer $OPENAI_API_KEY" | grep '"id"'

# Picks the best-known roles from the performer's TMDb credits. A few calls per job.
MODEL_ROLE_DISCOVERY=gpt-5.5

# Small text checks (character name cleanup, yes/no role checks).
MODEL_FAST=gpt-5.4-mini

# Identity verification from images. This is the quality-critical one — a
# better vision model here is the single biggest lever on wrong-person results.
MODEL_VISION=gpt-5.5

# How much newer models reason before answering: minimal | low | medium | high.
# Higher is slower and costs more per image.
MODEL_REASONING_EFFORT=low

# Roles per run. Each role costs image searches and identity checks.
MAX_ROLES=6

# ---------------------------------------------------------------------------
# Photo selection
# ---------------------------------------------------------------------------
# Photos delivered per role.
IMAGES_PER_ROLE=12
# Below this after the first search, a wider second search runs.
MIN_IMAGES_PER_ROLE=4
# Candidates downloaded and reviewed per search pass, per role.
CANDIDATES_PER_PASS=40
# Images the vision model reviews per call (plus the reference photo).
REVIEW_BATCH_SIZE=8
# Target mix per role. Slots a kind can't fill go to the others.
# For animated roles "solo" means official character art and screenshots.
MIX_SOLO=0.6
MIX_GROUP=0.25
MIX_POSTER=0.15
# Reviewer's print-quality score (1-5) a photo needs. 3 = fine, 4 = only strong shots.
MIN_PRINT_QUALITY=3
# Every photo of a person gets a second, one-at-a-time identity check against
# several reference photos before delivery. Confidence (1-10) it needs.
CONFIRM_CONFIDENCE=8
# Print-quality score (1-5) the final full-size check needs. 4 = good, 3 = fine.
FINAL_PRINT_QUALITY=4
# Always include each title's official poster at 11x17.
ALWAYS_POSTER=true
# Confirmed photos of the person that miss only on sharpness/quality (or are
# a little too small) go, uncropped, into potential_upscale/ in each package
# for manual refinement. Up to this many per role.
POTENTIAL_UPSCALE=true
UPSCALE_PER_ROLE=6

# Claude fallback, used only when the primary vision service errors.
ANTHROPIC_VERIFY_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# API server protection
# ---------------------------------------------------------------------------

# Shared secret. Leave EMPTY and every endpoint is open to anyone who can reach
# port 4000. Set it and callers must send X-API-Key. Note a key shipped to a
# browser is not really secret — the durable fix is to stop exposing port 4000
# and have the dashboard's server call it over localhost.
API_KEY=

# Each job spawns a process that downloads, resizes and zips. One vCPU and
# 2 GB does not survive many at once.
MAX_CONCURRENT_JOBS=2
MAX_JOBS_PER_HOUR=30
MAX_READS_PER_MINUTE=240

# ---------------------------------------------------------------------------
# Role cache
# ---------------------------------------------------------------------------

# Role discovery costs several model calls per name. Cached on disk under
# .cache/roles so repeat performers across events are free.
ROLE_CACHE=true
ROLE_CACHE_TTL_HOURS=720

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
MAX_IMAGES_PER_ROLE=50
DEDUP_THRESHOLD=0.85
API_PORT=4000
