# Backend API base URL as the BROWSER will call it.
# Was hardcoded to http://159.223.131.137:4000/api in the bundle, which meant the
# host could not change without a rebuild and the page could never be served over
# HTTPS (the call would become blocked mixed content).
# Leave unset to call /api on the same origin — correct when a reverse proxy
# fronts both the dashboard and the API.
NEXT_PUBLIC_API_BASE_URL=http://159.223.131.137:4000/api

# Set only if the backend has API_KEY configured. Note that anything with the
# NEXT_PUBLIC_ prefix is compiled into the client bundle and is therefore public;
# this is drive-by protection, not a secret.
# NEXT_PUBLIC_API_KEY=
